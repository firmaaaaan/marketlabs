        "flowchart": "node scripts/create-flowcharts.mjs && node scripts/convert-flowcharts-to-png.mjs"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "^11.16.0",
        "@softwaretechnik/dbml-renderer": "^1.0.31",
