        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "viz.js": "^2.1.2"
    },
    "dependencies": {
        "@fullcalendar/core": "^6.1.21",
        "@fullcalendar/daygrid": "^6.1.21",
        "@fullcalendar/interaction": "^6.1.21",
        "@fullcalendar/luxon": "^6.1.21",
        "@fullcalendar/timegrid": "^6.1.21",
        "luxon": "^1.28.1"
    }
