{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "erd": "dbml-renderer -i docs/ERD.dbml -f svg -o docs/ERD.svg && node scripts/svg-to-png.mjs",
